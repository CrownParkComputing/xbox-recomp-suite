set(CMAKE_CXX_STANDARD 20)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
include("${CMAKE_CURRENT_LIST_DIR}/Dependencies.cmake")
include("${CMAKE_CURRENT_SOURCE_DIR}/sdk/cmake/XbeRecomp.cmake")
enable_testing()

function(chihiro_port title image input_define expected_sha256)
    if(NOT EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/assets/${image}")
        message(STATUS "Supply assets/${image} to build ${title}; tools remain available")
        return()
    endif()
    file(SHA256 "${CMAKE_CURRENT_SOURCE_DIR}/assets/${image}" actual_sha256)
    if(NOT actual_sha256 STREQUAL expected_sha256)
        message(FATAL_ERROR "${image} differs from the executable supported by ${title}")
    endif()
    file(GLOB XBE_HOST_SOURCES CONFIGURE_DEPENDS src/common/*.cpp)
    add_xbe_image(${title} ${image} game.toml 32 game)
    target_compile_definitions(${title} PRIVATE "${input_define}=1")
    if(EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/tests/mouse_gun.cpp")
        add_executable(${title}MouseTests tests/mouse_gun.cpp)
        target_include_directories(${title}MouseTests PRIVATE src)
        target_compile_options(${title}MouseTests PRIVATE -UNDEBUG)
        add_test(NAME ${title}MouseTests COMMAND ${title}MouseTests)
        add_executable(${title}MouseSDLTests tests/mouse_sdl.cpp src/game/mouse_sdl.cpp
            "${XBE_SDK_DIR}/runtime/core/log.cpp")
        target_include_directories(${title}MouseSDLTests PRIVATE src "${XBE_SDK_DIR}/runtime")
        target_compile_definitions(${title}MouseSDLTests PRIVATE "${input_define}=1")
        target_compile_options(${title}MouseSDLTests PRIVATE -UNDEBUG)
        target_link_libraries(${title}MouseSDLTests PRIVATE SDL3::SDL3)
        add_test(NAME ${title}MouseSDLTests COMMAND ${title}MouseSDLTests)
    endif()
endfunction()
