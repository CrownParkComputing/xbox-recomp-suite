+TEST("iso: a borrowed document descriptor stays readable after its owner closes it") {
+    const auto xbe = Xbe();
+    const auto image = MakeImage(0, false, xbe);
+    const int fd = open(image.c_str(), O_RDONLY);
+    CHECK(fd >= 0);
+    kernel::Disc disc;
+    std::string error;
+    CHECK_MSG(disc.OpenFd(fd, "selected SD card image", error), error);
+    CHECK(fcntl(fd, F_GETFD) != -1);  // the caller still owns the supplied descriptor
+    close(fd);
+    std::filesystem::remove(image);  // the path can no longer be reopened
+    std::vector<uint8_t> got;
+    CHECK(disc.Load("DEFAULT.XBE", got));
+    CHECK(got == xbe);
+    kernel::Disc invalid;
+    CHECK(!invalid.OpenFd(-1, "invalid descriptor", error));
+}
+
+TEST("documents: nested game files use bounded owned descriptors and positioned reads") {
+    auto path = std::filesystem::temp_directory_path() / ("tree_test_" + std::to_string(getpid()));
+    const auto data = Xbe();
+    { std::ofstream file(path, std::ios::binary); file.write(reinterpret_cast<const char*>(data.data()), data.size()); }
+    std::vector<int> opened;
+    {
+        kernel::Disc disc;
+        kernel::Disc::Entry root{"", 0, 0, true, {}};
+        kernel::Disc::Entry folder{"DATA", 0, 0, true, {}};
+        for (uint64_t i = 0; i < 70; ++i)
+            folder.children.push_back({std::to_string(i) + ".bin", i, uint32_t(data.size()), false, {}});
+        root.children.push_back(std::move(folder));
+        std::string error;
+        CHECK_MSG(disc.OpenTree(std::move(root), [&](uint64_t) {
+            int fd = open(path.c_str(), O_RDONLY | O_CLOEXEC);
+            opened.push_back(fd); return fd;
+        }, "SD game folder", error), error);
+        for (int i = 0; i < 70; ++i) {
+            auto* entry = disc.Find("data\\" + std::to_string(i) + ".bin");
+            CHECK(entry != nullptr);
+            uint8_t got[16]{};
+            CHECK_EQ(disc.Read(*entry, data.size() - 8, got, sizeof got), 8u);
+            CHECK(std::memcmp(got, data.data() + data.size() - 8, 8) == 0);
+            CHECK_EQ(disc.Read(*entry, data.size(), got, sizeof got), 0u);
+        }
+        // Descriptor numbers can be reused after eviction. Count live handles
+        // through /proc instead of assuming an old numeric FD stays closed.
+        size_t live = 0;
+        for (auto& item : std::filesystem::directory_iterator("/proc/self/fd")) {
+            std::error_code ec;
+            if (std::filesystem::read_symlink(item.path(), ec) == path) ++live;
+        }
+        CHECK_EQ(live, size_t(64));
+        std::vector<uint8_t> got;
+        CHECK(disc.Load("DATA\\0.bin", got)); // reopen an evicted document
+        CHECK(got == data);
+        CHECK(disc.Find("DATA\\..\\data\\0.BIN") != nullptr);
+    }
+    for (int fd : opened) CHECK(fcntl(fd, F_GETFD) == -1);
+    std::filesystem::remove(path);
+}
