+// Xbox render targets can be rebound as vertex buffers without a CPU lock.
+// Bring generated vertices into the guest bytes before the input assembler reads them.
+void VulkanRenderer::SyncVertexTargets(const State& s) {
+    VertexShader fvf;
+    const VertexShader* layout = s.vs.get();
+    if (!(s.vs_handle & 1)) {
+        FvfInputs(s.vs_handle, fvf);
+        layout = &fvf;
+    }
+    if (!layout) return;
+    uint16_t used = 0;
+    for (const auto& in : layout->inputs)
+        if (in.stream >= 0 && in.stream < 16 && in.type && in.type != 2) used |= uint16_t(1u << in.stream);
+    for (unsigned i = 0; i < 16; ++i) {
+        if (!(used & (1u << i)) || !s.streams[i].vb) continue;
+        uint32_t data = mem::VirtualFromPhysical(kernel::R32(s.streams[i].vb + 4));
+        if (TargetStale(data)) continue;
+        for (auto& [key, t] : targets_) {
+            if (t.data != data || !t.drawn) continue;
+            if (t.depth) SyncDepthTarget(t);
+            else Sync(data, 0);
+        }
+    }
+}
+
+void VulkanRenderer::SyncDepthTarget(Target& t) {
+    // Integer depth/stencil has a different byte order from Vulkan's separate
+    // depth and stencil copies. Preserve those bytes for UBYTE4 vertex inputs.
+    const bool d16 = t.guest.format == 0x30;
+    if (!t.guest.linear || (!d16 && t.guest.format != 0x2E)) return;
+    const uint64_t pixels = uint64_t(t.w) * t.h;
+    BufferRef rb = ctx_.CreateBuffer(pixels * 5, VK_BUFFER_USAGE_TRANSFER_DST_BIT, Memory::Readback);
+    if (!rb) return;
+    Barrier(*t.res, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+    VkBufferImageCopy c{};
+    c.imageSubresource = {VK_IMAGE_ASPECT_DEPTH_BIT, 0, 0, 1};
+    c.imageExtent = {t.w, t.h, 1};
+    vkCmdCopyImageToBuffer(Cb(), t.res->image, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, rb->buffer, 1, &c);
+    if (!d16) {
+        c.bufferOffset = pixels * 4;
+        c.imageSubresource.aspectMask = VK_IMAGE_ASPECT_STENCIL_BIT;
+        vkCmdCopyImageToBuffer(Cb(), t.res->image, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, rb->buffer, 1, &c);
+    }
+    Flush();
+    rb->Invalidate();
+    for (uint32_t y = 0; y < t.gh; ++y) {
+        // Pick the centre host sample when rendering above the console resolution.
+        uint32_t hy = std::min(uint32_t((uint64_t(y) * 2 + 1) * t.h / (t.gh * 2)), t.h - 1);
+        auto* row = static_cast<uint8_t*>(kernel::HostPtr(t.data + y * t.guest.pitch));
+        for (uint32_t x = 0; x < t.gw; ++x) {
+            uint32_t hx = std::min(uint32_t((uint64_t(x) * 2 + 1) * t.w / (t.gw * 2)), t.w - 1);
+            uint64_t sample = uint64_t(hy) * t.w + hx;
+            uint32_t depth;
+            std::memcpy(&depth, rb->map + sample * 4, 4);
+            if (t.res->desc.format == VK_FORMAT_D32_SFLOAT_S8_UINT) {
+                float z;
+                std::memcpy(&z, &depth, 4);
+                depth = uint32_t(std::lround(std::clamp(z, 0.0f, 1.0f) * 16777215.0f));
+            }
+            if (d16) {
+                uint16_t value = uint16_t(std::lround(double(depth & 0xFFFFFF) * 65535.0 / 16777215.0));
+                std::memcpy(row + x * 2, &value, 2);
+            } else {
+                uint32_t value = (depth << 8) | rb->map[pixels * 4 + sample];
+                std::memcpy(row + x * 4, &value, 4);
+            }
+        }
+    }
+    t.drawn = false;
+    t.epoch = DirtyEpoch(t.data);
+    t.sig = MemSig(t.data, t.bytes);
 }
 
