+TEST("render: point sprites cover their size and generate texture 3 coordinates") {
+    REQUIRE(Vulkan());
+    for (float scale : {1.0f, 2.0f}) {
+      for (bool program : {false, true}) {
+        auto renderer = test::MakeRenderer(scale);
+        REQUIRE(renderer);
+        REQUIRE(renderer->Init(kW, kH));
+        GuestSurface rt(kFmtLinArgb, kW, kH), tex(kFmtLinArgb, 4, 4, true);
+        kernel::W32(tex.header + 12, (6 << 8) | (1 << 16) | (2 << 20) | (2 << 24));
+        kernel::W32(tex.header + 16, 0); // normalized, swizzled ARGB texture
+        for (uint32_t y = 0; y < 4; ++y)
+            for (uint32_t x = 0; x < 4; ++x) {
+                uint32_t index = (x & 1) | ((y & 1) << 1) | ((x & 2) << 1) | ((y & 2) << 2);
+                kernel::W32(tex.data + index * 4, Argb(255, x < 2 ? 220 : 0, y < 2 ? 160 : 0, 40));
+            }
+        GuestBuffer vb(RhwDiffuse({{{32, 32, 0.5f, 1}}}, {0xFFFFFFFF}));
+        State s = BaseState(rt.s, nullptr);
+        s.vs_handle = kFvfXyzRhw | kFvfDiffuse;
+        s.streams[0] = {vb.header, 20};
+        s.rs[kRsPointSize] = FloatBits(16);
+        s.rs[kRsPointSpriteEnable] = 1;
+        if (program) {
+            auto vs = std::make_shared<VertexShader>();
+            vs->handle = 0x1001;
+            vs->inputs[0] = {0, 0, 0x42};
+            vs->stream_stride[0] = 20;
+            vs->program = {0, 1u << 21 | 0x1B, 2u << 26, 0xFu << 12 | 1u << 11,
+                           0, 1u << 21 | 96u << 13 | 0x1B, 3u << 26, 0xFu << 12 | 1u << 11 | 3u << 3,
+                           0, 1u << 21 | 97u << 13, 3u << 26, 8u << 12 | 1u << 11 | 6u << 3 | 1u};
+            s.vs = vs;
+            s.vs_handle = vs->handle;
+            s.vsc[96] = {1, 1, 1, 1};
+            s.vsc[97] = {16, 0, 0, 0};
+            s.rs[kRsPointSize] = FloatBits(1);
+            s.rs[kRsPointScaleEnable] = 1;
+        }
+        for (auto& stage : s.tss) {
+            stage[kTssColorOp] = stage[kTssAlphaOp] = kTopSelectArg1;
+            stage[kTssColorArg1] = stage[kTssAlphaArg1] = kTaDiffuse;
+        }
+        s.tss[3][kTssColorArg1] = s.tss[3][kTssAlphaArg1] = kTaTexture;
+        s.textures[3] = tex.header;
+        renderer->Clear(s, 0, nullptr, kClearTarget, 0, 1, 0);
+        renderer->Draw(s, 1, 0, 1, nullptr);
+        renderer->Sync(rt.data, 0);
+        CHECK_EQ(rt.At(26, 26), Argb(255, 220, 160, 40));
+        CHECK_EQ(rt.At(37, 26), Argb(255, 0, 160, 40));
+        CHECK_EQ(rt.At(26, 37), Argb(255, 220, 0, 40));
+        CHECK_EQ(rt.At(37, 37), Argb(255, 0, 0, 40));
+        CHECK_EQ(rt.At(22, 32), 0u);
+        CHECK_EQ(rt.At(42, 32), 0u);
+        s.rs[kRsPointSizeMax] = FloatBits(8);
+        renderer->Clear(s, 0, nullptr, kClearTarget, 0, 1, 0);
+        renderer->Draw(s, 1, 0, 1, nullptr);
+        renderer->Sync(rt.data, 0);
+        CHECK_EQ(rt.At(26, 26), 0u);
+        CHECK_EQ(rt.At(30, 30), Argb(255, 220, 160, 40));
+      }
+    }
+}
