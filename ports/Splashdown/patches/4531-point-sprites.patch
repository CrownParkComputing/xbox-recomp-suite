-// a point covers its console pixel, several host pixels on an upscaled target: drawn as a quad of that size
+void FillPointConstants(const State& s, DrawConstants& c) {
+    auto value = [&](uint32_t state) { return std::bit_cast<float>(s.rs[state]); };
+    const float size = value(kRsPointSize), minimum = value(kRsPointSizeMin), maximum = value(kRsPointSizeMax);
+    c.point[0] = std::isfinite(size) && size > 0 ? size : 1;
+    c.point[1] = std::isfinite(minimum) ? std::clamp(minimum, 0.0f, 64.0f) : 0;
+    c.point[2] = std::isfinite(maximum) && maximum > 0 ? std::clamp(maximum, c.point[1], 64.0f) : 64;
+    c.point[3] = float((s.rs[kRsPointSpriteEnable] ? 1 : 0) | (s.rs[kRsPointScaleEnable] ? 2 : 0));
+}
