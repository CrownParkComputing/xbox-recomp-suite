+TEST("render: XRGB target textures sample opaque in fixed and programmable pipelines") {
+    REQUIRE(Vulkan());
+    for (uint32_t format : {kFmtLinArgb, 0x1Eu}) {
+        for (bool programmable : {false, true}) {
+            GuestSurface source(format, kW, kH, true), dest(kFmtLinArgb, kW, kH);
+            State from = BaseState(source.s, nullptr);
+            const auto colour = Argb(0, 200, 100, 50);
+            Vulkan()->Clear(from, 0, nullptr, kClearTarget, colour, 1, 0);
+            GuestBuffer vb({0, 0, .5f, 1, 0, 0, 64, 0, .5f, 1, 64, 0,
+                            0, 64, .5f, 1, 0, 64, 64, 64, .5f, 1, 64, 64});
+            State to = BaseState(dest.s, nullptr);
+            to.vs_handle = kFvfXyzRhw | kFvfTex1;
+            to.streams[0] = {vb.header, 24};
+            to.textures[0] = source.header;
+            to.tss[0][kTssColorArg1] = kTaTexture;
+            to.tss[0][kTssAlphaArg1] = kTaTexture;
+            to.simple[kMBlendEnable >> 2] = 1;
+            to.simple[kMSrcBlend >> 2] = 0x302;
+            to.simple[kMDestBlend >> 2] = 0x303;
+            if (programmable) {
+                to.ps = std::make_shared<PixelShader>();
+                to.ps->def[8] = 0x08; // final RGB = T0
+                to.ps->def[9] = 0x1800; // final alpha = T0.a
+                to.rs[kRsPsTextureModes] = 1;
+            }
+            const auto background = Argb(255, 0, 0, 255);
+            Vulkan()->Clear(to, 0, nullptr, kClearTarget, background, 1, 0);
+            Vulkan()->Draw(to, kTriangleStrip, 0, 4, nullptr);
+            Vulkan()->Sync(dest.data, 0);
+            CHECK_EQ(dest.At(32, 32), format == 0x1E ? Argb(255, 200, 100, 50) : background);
+        }
+    }
+}
