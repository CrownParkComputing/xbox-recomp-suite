+HLE_STDCALL(D3DDevice_DrawIndexedVerticesUP, 5) {
+    std::lock_guard<std::recursive_mutex> lock(g_lock);
+    Walk(Dev(kDevPush));
+    const uint32_t count = a[1], stride = a[4];
+    if (!count) return 0;
+    if (!a[2] || !a[3] || !stride || uint64_t(count) * stride > kUpHalf) {
+        LOG_FIRST(4, "d3d: invalid indexed UP draw, %u indices, stride %u", count, stride);
+        return 0x80070057u;
+    }
+    // The Xbox entry point expands 16-bit indices into inline vertices
+    // (VC3 0x10A83D..0x10A860). Copy into the same fenced UP ring used by
+    // non-indexed draws so the caller may reuse its memory after return.
+    std::vector<uint8_t> vertices(size_t(count) * stride);
+    for (uint32_t i = 0; i < count; ++i) {
+        const uint32_t index = R16(a[2] + i * 2);
+        std::memcpy(vertices.data() + size_t(i) * stride, HostPtr(a[3] + index * stride), stride);
+    }
+    DrawUp(a[0], count, vertices.data(), stride);
+    return 0;
+}
